{
  "name": "clap-ts",
  "version": "0.4.0",
  "description": "A type-safe CLI argument parser for TypeScript, inspired by Rust's clap crate. Full clap-style parsing, validation, help, subcommands, shell completions, man pages and markdown docs, with zero dependencies.",
  "type": "module",
  "source": "./src/index.ts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./completions": {
      "source": "./src/completions.ts",
      "types": "./dist/completions.d.ts",
      "import": "./dist/completions.js"
    },
    "./man": {
      "source": "./src/man.ts",
      "types": "./dist/man.d.ts",
      "import": "./dist/man.js"
    },
    "./markdown": {
      "source": "./src/markdown.ts",
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./testing": {
      "source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./config": {
      "source": "./src/config.ts",
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./argfile": {
      "source": "./src/argfile.ts",
      "types": "./dist/argfile.d.ts",
      "import": "./dist/argfile.js"
    },
    "./spec": {
      "source": "./src/spec.ts",
      "types": "./dist/spec.d.ts",
      "import": "./dist/spec.js"
    },
    "./install": {
      "source": "./src/install.ts",
      "types": "./dist/install.d.ts",
      "import": "./dist/install.js"
    },
    "./plugins": {
      "source": "./src/plugins.ts",
      "types": "./dist/plugins.d.ts",
      "import": "./dist/plugins.js"
    },
    "./output": {
      "source": "./src/output.ts",
      "types": "./dist/output.d.ts",
      "import": "./dist/output.js"
    },
    "./log": {
      "source": "./src/log.ts",
      "types": "./dist/log.d.ts",
      "import": "./dist/log.js"
    },
    "./progress": {
      "source": "./src/progress.ts",
      "types": "./dist/progress.d.ts",
      "import": "./dist/progress.js"
    },
    "./prompt": {
      "source": "./src/prompt.ts",
      "types": "./dist/prompt.d.ts",
      "import": "./dist/prompt.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "bench": "bun run bench/parse.bench.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run build",
    "check:readme": "python3 scripts/check-readme.py",
    "check:package": "node scripts/check-package.mjs",
    "ready": "bun run typecheck && bun test && bun run build && bun run check:readme && bun run check:package"
  },
  "keywords": [
    "cli",
    "clap",
    "argument-parser",
    "command-line",
    "typescript",
    "type-safe",
    "subcommands",
    "arg-parser",
    "flag-parser",
    "shell-completions",
    "man-page",
    "bun",
    "node"
  ],
  "author": "Salama Ashoush <salamaashoush@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/clap-ts.git"
  },
  "bugs": {
    "url": "https://github.com/salamaashoush/clap-ts/issues"
  },
  "homepage": "https://github.com/salamaashoush/clap-ts#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "mitata": "^1.0.34",
    "typescript": "^7.0.2"
  }
}
