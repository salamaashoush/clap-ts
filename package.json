{
  "name": "clap-ts",
  "version": "0.3.0",
  "description": "A type-safe CLI argument parser for TypeScript, inspired by Rust's clap crate. Full clap-style parsing, validation, help, subcommands, shell completions, man pages and markdown docs, with zero dependencies.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "bench": "bun run bench/parse.bench.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "clap",
    "argument-parser",
    "command-line",
    "typescript",
    "type-safe",
    "subcommands",
    "arg-parser",
    "flag-parser",
    "shell-completions",
    "man-page",
    "bun",
    "node"
  ],
  "author": "Salama Ashoush <salamaashoush@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salamaashoush/clap-ts.git"
  },
  "bugs": {
    "url": "https://github.com/salamaashoush/clap-ts/issues"
  },
  "homepage": "https://github.com/salamaashoush/clap-ts#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "mitata": "^1.0.34",
    "typescript": "^7.0.2"
  }
}
